# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real credentials.

# --- Postgres (app data: cases, notes, triage state, users) ---
POSTGRES_USER=soc_app
POSTGRES_PASSWORD=soc_app_password
POSTGRES_DB=soc_dashboard

# --- CORS ---
CORS_ORIGINS=http://localhost:5173

# --- Wazuh SIEM ---
# Mode: "mock" (default for standalone dev) or "real" (connects to running Wazuh cluster)
WAZUH_MODE=mock
WAZUH_API_URL=https://your-wazuh-host:55000
WAZUH_API_USER=wazuh-wui
WAZUH_API_PASSWORD=change_me
WAZUH_VERIFY_SSL=false
